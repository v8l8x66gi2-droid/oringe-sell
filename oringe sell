                <p class="text-gray-500 max-w-xs">基于科技创新，让每一颗水果的流转都有迹可循，让每一份信任都值得托付。</p>
            </div>
            <div class="text-right text-gray-600 text-sm">
                <p>© 2024 AgriTrust. All Rights Reserved.</p>
                <p class="mt-2">联系我们: contact@agritrust.ai</p>
            </div>
        </div>
    </footer>

    <script>
        const apiKey = ""; // 运行时自动注入

        // 初始化
        window.onload = () => {
            initChart();
            setTimeout(() => {
                document.getElementById('loader').style.opacity = '0';
                setTimeout(() => document.getElementById('loader').style.display = 'none', 500);
            }, 800);
            // 默认开启第一个手风琴
            toggleStep(1);
        };

        // 进度条
        window.onscroll = () => {
            const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
            const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const scrolled = (winScroll / height) * 100;
            document.getElementById("progress-bar").style.width = scrolled + "%";
        };

        // 图表
        let chart;
        function initChart() {
            const ctx = document.getElementById('marketChart').getContext('2d');
            chart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['2020', '2021', '2022', '2023', '2024', '2025E', '2026E'],
                    datasets: [{
                        data: [1.1, 1.15, 1.22, 1.3, 1.4, 1.58, 1.8],
                        borderColor: '#2563eb',
                        borderWidth: 5,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: '#2563eb',
                        pointBorderWidth: 3,
                        pointRadius: 6,
                        tension: 0.4,
                        fill: true,
                        backgroundColor: (context) => {
                            const chart = context.chart;
                            const {ctx, chartArea} = chart;
                            if (!chartArea) return null;
                            const gradient = ctx.createLinearGradient(0, chartArea.bottom, 0, chartArea.top);
                            gradient.addColorStop(0, 'rgba(37, 99, 235, 0)');
                            gradient.addColorStop(1, 'rgba(37, 99, 235, 0.1)');
                            return gradient;
                        }
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { display: false } },
                        y: { border: { dash: [5, 5] }, grid: { color: '#f3f4f6' } }
                    }
                }
            });

            // 新增：供应链效率对比柱状图
            const ctxEff = document.getElementById('efficiencyChart').getContext('2d');
            new Chart(ctxEff, {
                type: 'bar',
                data: {
                    labels: ['平均流转加价率 (%)', '生鲜流通损耗率 (%)'],
                    datasets: [
                        { label: '传统大宗供应链', data: [85, 35], backgroundColor: '#f59e0b', borderRadius: 6, barPercentage: 0.6 },
                        { label: 'AgriTrust 直采体系', data: [20, 12], backgroundColor: '#10b981', borderRadius: 6, barPercentage: 0.6 }
                    ]
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8 } } },
                    scales: { 
                        y: { beginAtZero: true, grid: { color: '#f3f4f6' } }, 
                        x: { grid: { display: false } } 
                    }
                }
            });
        }

        // 手风琴
        function toggleStep(id) {
            const content = document.getElementById(`content-${id}`);
            const icon = document.getElementById(`icon-${id}`);
            const isActive = content.classList.contains('active');
            
            // 关闭所有
            document.querySelectorAll('.accordion-content').forEach(c => c.classList.remove('active'));
            document.querySelectorAll('[id^="icon-"]').forEach(i => i.style.transform = 'rotate(0deg)');
            document.querySelectorAll('[id^="icon-"]').forEach(i => i.innerText = '＋');

            if (!isActive) {
                content.classList.add('active');
                icon.innerText = '－';
                icon.style.transform = 'rotate(180deg)';
            }
        }

        // Gemini 调用
        async function callGemini(prompt, system) {
            const endpoint = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;
            const payload = {
                contents: [{ parts: [{ text: prompt }] }],
                systemInstruction: { parts: [{ text: system }] }
            };
            try {
                const res = await fetch(endpoint, { method: 'POST', body: JSON.stringify(payload) });
                const data = await res.json();
                return data.candidates?.[0]?.content?.parts?.[0]?.text;
            } catch (e) { return "无法获取分析数据，请检查网络环境。"; }
        }

        async function predictMarket() {
            const result = await callGemini("简短预测水果市场数字化带来的利润提升空间。", "你是一个顶级商业顾问。");
            alert("AI 推演结果：" + result);
            chart.data.datasets[0].data[6] = 2.1;
            chart.update();
        }

        async function simulateAI(type) {
            const modal = document.getElementById('modal');
            const loader = document.getElementById('modal-loading');
            const body = document.getElementById('modal-body');
            const title = document.getElementById('modal-title');
            const text = document.getElementById('modal-text');

            modal.classList.remove('hidden');
            loader.classList.remove('hidden');
            body.classList.add('hidden');

            // 扩展 AI 请求逻辑以支持定价功能
            const query = type === 'audit' ? "扫描苹果供应链合同中的三个潜在法律漏洞。" : 
                          type === 'marketing' ? "为产地直采红富士苹果写一段能够引起城市白领共鸣的朋友圈卖货文案。" :
                          "基于当前季节和市场趋势，给出一份优质红富士苹果的智能定价建议和视觉分级标准。";
            
            const result = await callGemini(query, "你是一个农业科技专家。");

            // 扩展标题逻辑
            title.innerText = type === 'audit' ? "🔍 智能审计结果" : 
                              type === 'marketing' ? "✨ AI 营销助手" : 
                              "📊 智能定价与分级报告";
            
            text.innerText = result;
            loader.classList.add('hidden');
            body.classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('modal').classList.add('hidden');
        }
    </script>
</body>
</html>
